# ── Firm & rekening ────────────────────────────────────────────────────────
FIRM=ftmo
ACCOUNT_CCY=USD              # of EUR — MOET kloppen met MT5, anders is elke lot fout
TRADING_ENABLED=true         # false = alles loggen, niets versturen (dry run)

# ── Risico ─────────────────────────────────────────────────────────────────
RISK_PER_TRADE=150           # vast bedrag per trade, in ACCOUNT_CCY
MAX_OPEN_POSITIONS=10        # 0 = uit (niet doen op een prop-rekening)
MAX_RISK_TOTAL=1500          # som van open risico; houd ruim onder de daily loss limit

# ── Webhook ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=verzin-hier-iets-langs

# ── MetaApi / MT5 ──────────────────────────────────────────────────────────
META_API_TOKEN=
META_ACCOUNT_ID=
# META_DOMAIN=               # alleen als je token aan een regio-domein hangt

# ── Postgres ───────────────────────────────────────────────────────────────
DATABASE_URL=                # Railway zet deze automatisch bij een PostgreSQL-plugin

# ── Overig ─────────────────────────────────────────────────────────────────
TRACK_INTERVAL_SEC=60
MAX_BASIS_PCT=5              # harde weigergrens futures-vs-CFD basis
DATA_MAX_BASIS_PCT=3         # zachte grens: wel plaatsen, niet meetellen
ENFORCE_EXPIRY=false
# EURUSD=1.16                # alleen bijstellen als de koers ver wegloopt
# GBPUSD=1.33
